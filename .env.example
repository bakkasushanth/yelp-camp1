# Environment mode (development | production)
NODE_ENV=development

# Server port (Note: app.js currently defaults to 3000)
PORT=3000

# MongoDB connection URI
DB_URL=mongodb://127.0.0.1:27017/yelp-camp

# Secret key for session encryption and MongoStore
SECRET=replace_with_a_long_random_string

# Cloudinary cloud name for image hosting
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Cloudinary API key
CLOUDINARY_KEY=your_cloudinary_api_key

# Cloudinary API secret
CLOUDINARY_SECRET=your_cloudinary_api_secret

# MapTiler API key for geocoding and interactive map rendering
MAPTILER_API_KEY=your_maptiler_api_key

